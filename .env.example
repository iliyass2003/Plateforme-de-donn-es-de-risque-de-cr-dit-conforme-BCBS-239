# ============================================================
# Modèle de configuration. Copier en .env et remplir les vraies valeurs.
# Ne jamais mettre de mot de passe réel dans ce fichier.
# ============================================================

# --- Environnement : dev (échantillon 10 %), ci (1 %), prod (complet)
ENV=dev

# --- PostgreSQL (warehouse)
POSTGRES_USER=admin_warehouse
POSTGRES_PASSWORD=changer_moi
POSTGRES_DB=credit_risk
POSTGRES_PORT=5440

# --- MinIO (zone landing)
MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=changer_moi_8_caracteres_minimum
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
